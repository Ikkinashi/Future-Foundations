12. SERVICE INTERFACE

public interface IENTITYService {
    // 1. CREATE
    ENTITY create(ENTITY entity);

    // 2. READ
    ENTITY read(ID_TYPE id);

    // 3. UPDATE
    ENTITY update(ENTITY entity);

    // 4. DELETE
    boolean delete(ID_TYPE id);

    // 5. GET ALL
    java.util.List<ENTITY> getAll();
}

13. SERVICE IMPLEMENTATION

@Service
public class ENTITYService implements IENTITYService {
    // 1. REPOSITORY
    private final ENTITYRepository repository;

    // 2. CONSTRUCTOR
    public ENTITYService(ENTITYRepository repository) {
        this.repository = repository;
    }

    // 3. CREATE
    @Override
    public ENTITY create(ENTITY entity) {
        return repository.save(entity);
    }

    // 4. READ
    @Override
    public ENTITY read(ID_TYPE id) {
        return repository.findById(id).orElse(null);
    }

    // 5. UPDATE
    @Override
    public ENTITY update(ENTITY entity) {
        return repository.save(entity);
    }

    // 6. DELETE
    @Override
    public boolean delete(ID_TYPE id) {
        if (repository.existsById(id)) {
            repository.deleteById(id);
            return true;
        }
        return false;
    }

    // 7. GET ALL
    @Override
    public java.util.List<ENTITY> getAll() {
        return repository.findAll();
    }
}

