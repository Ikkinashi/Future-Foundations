        ENTITY saved = service.create(entity);
        boolean deleted = service.delete(saved.getId());
        assertTrue(deleted);
    }
}

15. CONTROLLER — HTTP ENDPOINTS

@RestController
@RequestMapping("/entity")
public class ENTITYController {
    // 1. SERVICE
    private final ENTITYService service;

    // 2. CONSTRUCTOR
    public ENTITYController(ENTITYService service) {
        this.service = service;
    }

    // 3. CREATE
    @PostMapping("/create")
    public ENTITY create(@RequestBody ENTITY entity) {
        return service.create(entity);
    }

    // 4. READ
    @GetMapping("/read/{id}")
    public ENTITY read(@PathVariable ID_TYPE id) {
        return service.read(id);
    }

    // 5. UPDATE
    @PutMapping("/update")
    public ENTITY update(@RequestBody ENTITY entity) {
        return service.update(entity);
    }

    // 6. DELETE
    @DeleteMapping("/delete/{id}")
    public boolean delete(@PathVariable ID_TYPE id) {
        return service.delete(id);
    }

    // 7. GET ALL
    @GetMapping("/all")
    public java.util.List<ENTITY> getAll() {
        return service.getAll();
    }
}

