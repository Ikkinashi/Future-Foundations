    // 3. READ TEST
    @Test
    void testRead() {
        ENTITY entity = ENTITYFactory.createENTITY(
                VALID_VALUE1, VALID_VALUE2, VALID_VALUE3
        );
        ENTITY saved = service.create(entity);
        ENTITY found = service.read(saved.getId());
        assertNotNull(found);
    }

    // 4. DELETE TEST
    @Test
    void testDelete() {
        ENTITY entity = ENTITYFactory.createENTITY(
                VALID_VALUE1, VALID_VALUE2, VALID_VALUE3
