04. EMBEDDED OBJECT / COMPOSITE PRIMARY KEY

@Embeddable
public class KEYCLASS implements java.io.Serializable {
    private TYPE1 field1;
    private TYPE2 field2;

    protected KEYCLASS() {}
    private KEYCLASS(Builder builder) {
        this.field1 = builder.field1;
        this.field2 = builder.field2;
    }

    public TYPE1 getField1() { return field1; }
    public TYPE2 getField2() { return field2; }

    public static class Builder {
        private TYPE1 field1;
        private TYPE2 field2;

        public Builder setField1(TYPE1 field1) {
            this.field1 = field1;
            return this;
        }
        public Builder setField2(TYPE2 field2) {
            this.field2 = field2;
            return this;
        }

        public KEYCLASS build() { return new KEYCLASS(this); }
    }

    // 7. COMPOSITE KEY EQUALITY
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof KEYCLASS)) return false;
        KEYCLASS other = (KEYCLASS) obj;
        return java.util.Objects.equals(field1, other.field1)
            && java.util.Objects.equals(field2, other.field2);
    }
    @Override
    public int hashCode() {
        return java.util.Objects.hash(field1, field2);
    }
}

05. COMPOSITION / OWNER DOMAIN CLASS

@Entity
public class OWNER {
    @Id
    private ID_TYPE id;
    @Embedded
    private VALUEOBJECT valueObject;
    @OneToMany
    private java.util.List<RELATED> relatedObjects = new java.util.ArrayList<>();

    // 2. CONSTRUCTORS
    protected OWNER() {}
    private OWNER(Builder builder) {
        this.id = builder.id;
        this.valueObject = builder.valueObject;
        this.relatedObjects = builder.relatedObjects;
    }

    // 3. GETTERS
    public ID_TYPE getId() { return id; }
    public VALUEOBJECT getValueObject() { return valueObject; }
    public java.util.List<RELATED> getRelatedObjects() { return relatedObjects; }

    // 4. BUILDER
    public static class Builder {
        private ID_TYPE id;
        private VALUEOBJECT valueObject;
        private java.util.List<RELATED> relatedObjects = new java.util.ArrayList<>();

        // 5. SETTERS
        public Builder setId(ID_TYPE id) { this.id = id; return this; }
        public Builder setValueObject(VALUEOBJECT valueObject) {
            this.valueObject = valueObject;
            return this;
        }
        public Builder setRelatedObjects(java.util.List<RELATED> relatedObjects) {
            this.relatedObjects = relatedObjects;
            return this;
        }

        // 6. BUILD
        public OWNER build() { return new OWNER(this); }
    }
}

06. JPA RELATIONSHIPS — ALTERNATIVES, NOT ONE CLASS

// 1. ONE TO ONE
@OneToOne
private OTHER other;

// 2. ONE TO MANY
@OneToMany
private java.util.List<OTHER> others;

// 3. MANY TO ONE
@ManyToOne
private OTHER other;

// 4. MANY TO MANY
@ManyToMany
private java.util.List<OTHER> others;

// 5. BIDIRECTIONAL PARENT SIDE
@OneToMany(mappedBy = "parent")
private java.util.List<CHILD> children;

// 6. BIDIRECTIONAL CHILD SIDE
@ManyToOne
@JoinColumn(name = "parent_id")
private PARENT parent;

// 7. EMBEDDED NON-KEY OBJECT
@Embedded
private VALUEOBJECT valueObject;

// 8. EMBEDDED COMPOSITE KEY
@EmbeddedId
private KEYCLASS key;

