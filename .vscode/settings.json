08. FACTORY — NORMAL OR INHERITED ENTITY

public class ENTITYFactory {
    public static ENTITY createENTITY(TYPE1 field1, TYPE2 field2, TYPE3 field3) {
        if (INVALID_CONDITION) {
            return null;
        }

        return new ENTITY.Builder()
                .setField1(field1)
                .setField2(field2)
                .setField3(field3)
                .build();
    }
}

09. FACTORY — COMPOSITION

public class OWNERFactory {
    public static OWNER createOWNER(VALUEOBJECT valueObject, java.util.List<RELATED> relatedObjects) {
        if (valueObject == null || relatedObjects == null) {
            return null;
        }

        return new OWNER.Builder()
                .setValueObject(valueObject)
                .setRelatedObjects(relatedObjects)
                .build();
    }
}

