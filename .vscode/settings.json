01. PARENT DOMAIN CLASS — INHERITANCE

@Entity
@Inheritance(strategy = InheritanceType.JOINED)
public abstract class PARENT {
    @Id
    protected ID_TYPE id;
    protected TYPE1 field1;
    protected TYPE2 field2;

    protected PARENT() {}
    protected PARENT(Builder<?> builder) {
        this.id = builder.id;
        this.field1 = builder.field1;
        this.field2 = builder.field2;
    }

    public ID_TYPE getId() { return id; }
    public TYPE1 getField1() { return field1; }
    public TYPE2 getField2() { return field2; }

    public static abstract class Builder<T extends Builder<T>> {
        protected ID_TYPE id;
        protected TYPE1 field1;
        protected TYPE2 field2;

        public T setId(ID_TYPE id) { this.id = id; return self(); }
        public T setField1(TYPE1 field1) { this.field1 = field1; return self(); }
        public T setField2(TYPE2 field2) { this.field2 = field2; return self(); }

        protected abstract T self();
    }
}


02. CHILD DOMAIN CLASS — INHERITED BUILDER

@Entity
public class CHILD extends PARENT {
    private TYPE1 childField1;
    private TYPE2 childField2;

    protected CHILD() { super(); }
    private CHILD(Builder builder) {
        super(builder);
        this.childField1 = builder.childField1;
        this.childField2 = builder.childField2;
    }

    public TYPE1 getChildField1() { return childField1; }
    public TYPE2 getChildField2() { return childField2; }

    public static class Builder extends PARENT.Builder<Builder> {
        private TYPE1 childField1;
        private TYPE2 childField2;

        public Builder setChildField1(TYPE1 childField1) {
            this.childField1 = childField1;
            return this;
        }
        public Builder setChildField2(TYPE2 childField2) {
            this.childField2 = childField2;
            return this;
        }

        @Override
        protected Builder self() { return this; }

        public CHILD build() { return new CHILD(this); }
    }
}

